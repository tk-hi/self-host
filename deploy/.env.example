# Copy to deploy/.env on the instance and fill in. Never commit the filled copy.
# ---------------------------------------------------------------------------

# --- model ---------------------------------------------------------------
# Pick ONE of the profiles below (see deploy/profiles/ for ready-made copies).
MODEL_ID=Qwen/Qwen3.8-27B-FP8
SERVED_MODEL_NAME=qwen3.8-27b
MAX_MODEL_LEN=65536
GPU_MEM_UTIL=0.92
KV_CACHE_DTYPE=auto
TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
EXTRA_VLLM_ARGS=""

# --- images (pin these once you have a working combination) --------------
# The qwen38 tag is the image the vLLM recipe recommends for Qwen3.8
# (min vLLM 0.17.0; ships the transformers version the checkpoint needs).
VLLM_IMAGE=vllm/vllm-openai:qwen38

# --- storage on the instance ---------------------------------------------
HF_CACHE_DIR=/workspace/hf-cache

# --- secrets --------------------------------------------------------------
# Shared secret between Open WebUI and vLLM. vLLM is not publicly reachable,
# but this stops anything else on the instance from using the GPU for free.
# Generate with: openssl rand -hex 32
VLLM_API_KEY=
# Signs Open WebUI session cookies. Changing it logs everyone out.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=
# Tavily web search.
TAVILY_API_KEY=
# Only needed for gated repos; the Qwen weights are open.
HF_TOKEN=
# Privacy sandwich (services/privacy-pipeline) frontier hop. If unset, the
# pipeline falls back to the local vLLM (labeled) and runs fully offline.
ANTHROPIC_API_KEY=

# --- exposure -------------------------------------------------------------
# Host port for Open WebUI. Must match the -p mapping requested at instance
# creation time so vast.ai assigns it a public port.
WEBUI_PORT=8080
# Set to false after you have created your admin account to seal signups.
ENABLE_SIGNUP=true

# Set to 1 only if the vLLM image includes hf_transfer.
HF_TRANSFER=0
