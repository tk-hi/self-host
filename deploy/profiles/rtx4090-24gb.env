# RTX 4090 24GB — 4-bit AWQ is mandatory; FP8 weights (~32GB) do not fit.
# Weights ~17GB + 64k KV cache at fp8 (~3GB) leaves a thin but workable margin.
# If vLLM OOMs on startup, drop MAX_MODEL_LEN to 40960 before touching
# GPU_MEM_UTIL — the KV cache is what is squeezing you, not the weights.
MODEL_ID=cpatonn/Qwen3-30B-A3B-Instruct-2507-AWQ-4bit
SERVED_MODEL_NAME=qwen3-30b-a3b
MAX_MODEL_LEN=65536
GPU_MEM_UTIL=0.95
KV_CACHE_DTYPE=fp8
TOOL_PARSER=hermes
EXTRA_VLLM_ARGS="--quantization awq_marlin"
