# RTX 4090 24GB — 4-bit AWQ is mandatory; FP8 weights (~29GiB) do not fit.
# cyankiwi's AWQ-INT4 is ~21GB on disk; --language-model-only skips the vision
# tower to claw back VRAM (Open WebUI is text chat anyway), and the hybrid
# attention KV cache is only ~2GB at 64k in fp8. Thin but workable margin.
# If vLLM OOMs on startup, drop MAX_MODEL_LEN to 40960 before touching
# GPU_MEM_UTIL — the KV cache is what is squeezing you, not the weights.
MODEL_ID=cyankiwi/Qwen3.8-27B-AWQ-INT4
SERVED_MODEL_NAME=qwen3.8-27b
MAX_MODEL_LEN=65536
GPU_MEM_UTIL=0.95
KV_CACHE_DTYPE=fp8
TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
EXTRA_VLLM_ARGS="--language-model-only --max-num-seqs 4 --enforce-eager"
