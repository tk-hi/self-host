# RTX PRO 6000 Blackwell 96GB (WS/Max-Q/Server, SM 12.0) — same W4A16
# uncensored weights as the 5090 profile for apples-to-apples testing across
# stacks, but 96GB removes every capacity workaround:
#   - context raised to the model's native 262144 (fp8 KV ~32KB/token -> ~8GB
#     for one full-length sequence; utilization 0.90 of 96GB leaves room for
#     several concurrent full-context requests)
#   - no --enforce-eager (that was an OOM workaround on 24GB; CUDA graphs on)
#   - no --max-num-seqs cap
# Same Blackwell/CUDA>=12.9 FlashInfer gotcha as the 5090 — handled by
# native-setup.sh (installs cuda-toolkit-13-0 when compute_cap >= 120).
MODEL_ID=philbert440/Qwen3.8-27B-Uncensored-Aggressive-W4A16-AWQ
SERVED_MODEL_NAME=qwen3.8-27b-uncensored
MAX_MODEL_LEN=262144
GPU_MEM_UTIL=0.90
KV_CACHE_DTYPE=fp8
TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
EXTRA_VLLM_ARGS="--language-model-only"
