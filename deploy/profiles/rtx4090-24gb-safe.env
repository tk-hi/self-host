# RTX 4090 24GB, conservative fallback — dense 14B at 4-bit. Fits comfortably
# at 64k with room to spare. Use if the 30B-A3B AWQ profile will not stay up.
MODEL_ID=Qwen/Qwen3-14B-AWQ
SERVED_MODEL_NAME=qwen3-14b
MAX_MODEL_LEN=65536
GPU_MEM_UTIL=0.92
KV_CACHE_DTYPE=fp8
TOOL_PARSER=hermes
EXTRA_VLLM_ARGS="--quantization awq_marlin"
