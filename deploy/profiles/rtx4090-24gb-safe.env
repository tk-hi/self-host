# RTX 4090 24GB, conservative fallback — previous-gen Qwen3.5-27B in the
# official GPTQ Int4 (~17GB weights, same hybrid-attention family). Fits 64k
# comfortably. Use if the Qwen3.8 AWQ profile will not stay up.
MODEL_ID=Qwen/Qwen3.5-27B-GPTQ-Int4
SERVED_MODEL_NAME=qwen3.5-27b
MAX_MODEL_LEN=65536
GPU_MEM_UTIL=0.92
KV_CACHE_DTYPE=fp8
TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
EXTRA_VLLM_ARGS="--language-model-only"
