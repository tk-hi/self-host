# A100 80GB — official block-scaled FP8 checkpoint, full 64k context.
# Weights ~28.7GiB; the hybrid attention KV cache (16 full-attention layers,
# 4 KV heads x 256 dim) is ~4GB at 64k in bf16, so headroom is generous.
MODEL_ID=Qwen/Qwen3.8-27B-FP8
SERVED_MODEL_NAME=qwen3.8-27b
MAX_MODEL_LEN=65536
GPU_MEM_UTIL=0.90
KV_CACHE_DTYPE=auto
TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
EXTRA_VLLM_ARGS=""
