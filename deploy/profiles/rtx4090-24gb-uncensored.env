# RTX 4090 24GB — community "uncensored" abliteration of Qwen3.8-27B in
# W4A16 compressed-tensors (~18GiB). Note: this is philbert440's abliteration,
# NOT a quant of orcarouter's (whose FP8 is ~29GiB and needs an 80GB card).
# Same memory recipe as the standard 4090 profile.
MODEL_ID=philbert440/Qwen3.8-27B-Uncensored-Aggressive-W4A16-AWQ
SERVED_MODEL_NAME=qwen3.8-27b-uncensored
MAX_MODEL_LEN=65536
GPU_MEM_UTIL=0.95
KV_CACHE_DTYPE=fp8
TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
EXTRA_VLLM_ARGS="--language-model-only --max-num-seqs 4 --enforce-eager"
