<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
{% include "_base.css.j2" %}

.memo-section { margin-bottom: 9mm; }
.memo-section h3 { margin-top: 4mm; }
</style>
</head>
<body>

<div class="cover">
  <div class="rule"></div>
  <h1>{{ meta.title }}</h1>
  <div class="subtitle">{{ meta.subtitle }}</div>
  <div class="client">{{ meta.client_name }}</div>
  <div class="prepared">Prepared by {{ meta.prepared_by }}</div>
  <div class="date">{{ meta.date }}</div>
</div>

{% for section in sections %}
<div class="memo-section">
  <h3>{{ section.title }}</h3>
  <div class="heading-rule"></div>
  {% for p in section.intro_paragraphs %}<p>{{ p }}</p>{% endfor %}
</div>
{% endfor %}

</body>
</html>
