{# Shared stylesheet. Rendered inside a <style> block; edit freely — the app
   only passes `meta`, `font_dir` and the document body. #}

@font-face {
  font-family: "Source Serif 4";
  src: url("{{ font_dir }}/SourceSerif4-Regular.ttf");
  font-weight: 400; font-style: normal;
}
@font-face {
  font-family: "Source Serif 4";
  src: url("{{ font_dir }}/SourceSerif4-It.ttf");
  font-weight: 400; font-style: italic;
}
@font-face {
  font-family: "Source Serif 4";
  src: url("{{ font_dir }}/SourceSerif4-Semibold.ttf");
  font-weight: 600; font-style: normal;
}
@font-face {
  font-family: "Source Serif 4";
  src: url("{{ font_dir }}/SourceSerif4-Bold.ttf");
  font-weight: 700; font-style: normal;
}

@page {
  size: A4;
  margin: 24mm 22mm 26mm 22mm;
  @bottom-left {
    content: "{{ meta.confidential_line|replace('"', "'") }}";
    font-family: "Source Serif 4"; font-size: 7.5pt; font-style: italic;
    color: #8a8a8a;
  }
  @bottom-right {
    content: "Page " counter(page) " of " counter(pages);
    font-family: "Source Serif 4"; font-size: 7.5pt; color: #8a8a8a;
  }
}

html { font-family: "Source Serif 4", serif; font-size: 10.5pt;
       line-height: 1.55; color: #1c1c1c; }
p { margin: 0 0 0.7em 0; text-align: justify; hyphens: auto; }

/* ---- cover ---- */
.cover { page-break-after: always; padding-top: 55mm; }
.cover .rule { width: 34mm; height: 1.2mm; background: {{ meta.accent_color }};
               margin-bottom: 9mm; }
.cover h1 { font-size: 27pt; font-weight: 700; line-height: 1.18;
            margin: 0 0 4mm 0; }
.cover .subtitle { font-size: 13pt; font-style: italic; color: #4a4a4a;
                   margin-bottom: 16mm; }
.cover .client { font-size: 12pt; font-weight: 600;
                 color: {{ meta.accent_color }}; margin-bottom: 2mm; }
.cover .prepared, .cover .date { font-size: 10pt; color: #4a4a4a; }

/* ---- section dividers ---- */
.divider { page-break-before: always; padding-top: 90mm; text-align: center; }
.divider .kicker { font-size: 9pt; letter-spacing: 0.25em;
                   text-transform: uppercase; color: {{ meta.accent_color }};
                   margin-bottom: 6mm; }
.divider h2 { font-size: 21pt; font-weight: 600; margin: 0 0 8mm 0; }
.divider .intro { max-width: 118mm; margin: 0 auto; font-style: italic;
                  color: #3c3c3c; text-align: center; }
.divider .intro p { text-align: center; }

/* ---- headings / rules ---- */
h3 { font-size: 14pt; font-weight: 600; margin: 0 0 1.5mm 0; }
.heading-rule { width: 100%; height: 0.45mm; background: {{ meta.accent_color }};
                margin: 0 0 6mm 0; }
h4 { font-size: 9.5pt; font-weight: 600; letter-spacing: 0.18em;
     text-transform: uppercase; color: {{ meta.accent_color }};
     margin: 7mm 0 2.5mm 0; }
